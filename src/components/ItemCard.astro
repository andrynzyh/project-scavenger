---
import EntryIcon from './EntryIcon.astro';
import { resolveIcon } from '../lib/icons';

interface Props {
  id: string;
  href: string;
  title: string;
  emoji?: string;
  icon?: string;
  category?: string;
  owner?: string;
  description?: string;
}

const { id, href, title, emoji, icon, category, owner, description } = Astro.props;
const iconPath = resolveIcon({ collection: 'items', slug: id, icon });
---

<a class="item-card" href={href} aria-label={`${title} details`}>
  <span class="item-card__thumb">
    <EntryIcon name={iconPath} emoji={emoji} />
  </span>

  <span class="item-card__body">
    {category && <span class="item-card__cat">{category}</span>}
    <span class="item-card__title">{title}</span>
    {description && <span class="item-card__desc">{description}</span>}
    {owner && <span class="item-card__owner">Owner: {owner}</span>}
  </span>
</a>

<style>
  .item-card {
    display: flex;
    gap: 0.9rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .item-card:hover {
    border-color: color-mix(in srgb, var(--accent-2) 5%, transparent);
    transform: translateY(-2px);
  }

  .item-card__thumb {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 10px;
    background: #ffffff;
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    overflow: hidden;
  }

  .item-card__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .item-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .item-card__cat {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
  }

  .item-card__title {
    font-weight: 700;
  }

  .item-card__desc {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .item-card__owner {
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
