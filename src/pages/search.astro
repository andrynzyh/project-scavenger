---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getAllCollectionNames } from '../lib/navigation';
import { resolveIcon, IMAGE_EXT_RE } from '../lib/icons';
import { withBase } from '../lib/paths';

// Satu indeks pencarian untuk SEMUA koleksi — URL base selalu /<name>/
// karena setiap koleksi memakai nama foldernya sebagai segmen URL.
const baseOf = (name: string): string => withBase(`/${name}/`);

/* eslint-disable-next-line @typescript-eslint/no-explicit-any */
const labelOf = (d: Record<string, any>): string =>
  [d.category ?? d.stage ?? d.rank, d.owner].filter(Boolean).join(' · ') ||
  'Page';

const entries = (
  await Promise.all(
    getAllCollectionNames().map(async (name) => {
      const items = await getCollection(
        name as Parameters<typeof getCollection>[0]
      );
      return items
        .sort(
          (a, b) =>
            ((a.data as Record<string, unknown>).order as number ?? 99) -
            ((b.data as Record<string, unknown>).order as number ?? 99)
        )
        .map((entry) => {
          const d = entry.data as Record<string, any>;
          const tags = Array.isArray(d.tags) ? (d.tags as string[]) : [];
          const icon = resolveIcon({
            collection: name,
            slug: entry.id,
            icon: d.icon as string | undefined,
          });
          return {
            href: baseOf(name) + entry.id + '/',
            title: d.title as string,
            emoji: (d.emoji as string) ?? '',
            icon,
            // Precomputed server-side so the client script needs no regex
            iconIsImage: icon ? IMAGE_EXT_RE.test(icon) : false,
            label: labelOf(d),
            description: d.description as string,
            hay: [
              d.title,
              d.description,
              d.stage ?? '',
              d.category ?? '',
              d.rank ?? '',
              d.role ?? '',
              tags.join(' '),
            ].join(' '),
          };
        });
    })
  )
).flat();
---

<BaseLayout title="Search — project-scavenger" description="Instantly search every wiki entry.">
  <div class="wrap">
    <h1>Search</h1>
    <p class="muted">
      Instant search across every section — {entries.length} items, works
      offline, no server needed.
    </p>

    <input
      id="q"
      type="search"
      placeholder='Type to filter… try "greymon" or "vaccine"'
      autocomplete="off"
      autofocus
    />
    <ul id="results"></ul>
  </div>
</BaseLayout>

<script type="application/json" id="search-index" set:html={JSON.stringify(entries).replace(/</g, '\\u003c')} />

<script>
  // The index lives in a JSON <script> tag above; THIS script is bundled by
  // Astro into a hashed, cacheable file — unlike the old inline define:vars
  // payload that was re-sent inside the HTML on every visit.
  const input = document.getElementById('q') as HTMLInputElement;
  const list = document.getElementById('results') as HTMLUListElement;
  const dataEl = document.getElementById('search-index');
  const entries: { hay: string; lc?: string; [key: string]: unknown }[] =
    JSON.parse(dataEl?.textContent ?? '[]');

  // Cap DOM rows per render — the count note tells users to refine instead.
  const MAX_RESULTS = 60;

  // Lowercase the haystack ONCE at load, not on every keystroke.
  for (const e of entries) e.lc = (e.hay as string).toLowerCase();

  function render(items: typeof entries, total: number) {
    list.textContent = '';
    if (items.length === 0) {
      const li = document.createElement('li');
      li.className = 'empty';
      li.textContent = 'No results found. Try another term!';
      list.appendChild(li);
      return;
    }

    // One DocumentFragment → single reflow instead of one per row.
    const frag = document.createDocumentFragment();
    for (const item of items) {
      const li = document.createElement('li');

      const link = document.createElement('a');
      link.href = item.href as string;

      // Icon: resolved image (digimon/items/gear) wins; emoji is the fallback
      if (item.iconIsImage && item.icon) {
        const img = document.createElement('img');
        img.src = item.icon as string;
        img.alt = '';
        img.loading = 'lazy';
        img.decoding = 'async';
        img.className = 'result-icon';
        link.appendChild(img);
      } else if (item.emoji) {
        link.appendChild(document.createTextNode(item.emoji + ' '));
      }

      link.appendChild(document.createTextNode(item.title as string));

      if (item.label) {
        const label = document.createElement('span');
        label.className = 'result-label';
        label.textContent = ' — ' + item.label;
        link.appendChild(label);
      }

      const desc = document.createElement('p');
      desc.className = 'muted';
      desc.textContent = item.description as string;

      li.appendChild(link);
      li.appendChild(desc);
      frag.appendChild(li);
    }

    if (total > items.length) {
      const li = document.createElement('li');
      li.className = 'empty';
      li.textContent =
        'Showing ' + items.length + ' of ' + total + ' results — refine your search to narrow it down.';
      frag.appendChild(li);
    }

    list.appendChild(frag);
  }

  function run() {
    const query = input.value.trim().toLowerCase();
    if (!query) return render(entries, entries.length);
    const matches = entries.filter(function (entry) {
      return (entry.lc as string).includes(query);
    });
    render(matches.slice(0, MAX_RESULTS), matches.length);
  }

  // Debounce 120ms — skip re-filtering mid-typing bursts.
  let timer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', function () {
    clearTimeout(timer);
    timer = setTimeout(run, 120);
  });
  run();
</script>

<style>
  .wrap {
    max-width: 760px;
    margin-inline: auto;
    padding: 2.5rem 0 4rem;
  }
  input {
    width: 100%;
    margin: 1rem 0;
    padding: 0.8rem 1rem;
    font-size: 1.05rem;
    font-family: var(--font-mono);
    color: var(--text);
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(41, 241, 156, 0.15);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  /* Result rows are created at RUNTIME (document.createElement), so Astro's
     scoped styles can't match them (no data-astro-cid attribute). Anchor
     these to #results and mark them :global — the id keeps them from leaking
     into header/footer lists on this page. */
  :global(#results li) {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
  }
  :global(#results li a) {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
  }
  :global(#results li a:hover) { color: var(--accent); }
  :global(#results li p) {
    margin: 0.3rem 0 0;
    font-size: 0.88rem;
  }
  :global(#results .empty) {
    text-align: center;
    color: var(--muted);
    border-style: dashed;
  }
  :global(#results .result-icon) {
    width: 1.2em;
    height: 1.2em;
    object-fit: contain;
    display: inline-block;
    vertical-align: -0.2em;
    margin-right: 0.3rem;
  }
  :global(#results .result-label) {
    margin-left: 0.25rem;
    font-weight: 400;
    font-size: 0.78rem;
    color: var(--muted);
  }
</style>
