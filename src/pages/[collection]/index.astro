---
/**
 * INDEX KOLEKSI — satu halaman untuk SEMUA koleksi (delapan koleksi terdaftar
 * di src/lib/collections.ts). Menampilkan daftar terkelompok + filter pencarian
 * + dropdown per-field (mis. Rank/Attribute/Type untuk digimon).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryIcon from '../../components/EntryIcon.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';
import { getCollectionMeta, COLLECTION_NAMES } from '../../lib/collections';
import { getSectionByCollection, buildNavSection } from '../../lib/navigation';

export async function getStaticPaths() {
  return COLLECTION_NAMES.map((collection) => ({ params: { collection } }));
}

const { collection } = Astro.params;
const section = getSectionByCollection(collection!)!;
const filters = getCollectionMeta(collection!)?.filters ?? [];
const entries = await getCollection(
  collection as Parameters<typeof getCollection>[0]
);
const nav = buildNavSection(section, entries);
---

<BaseLayout
  title={`${section.label} — project-scavenger`}
  description={section.blurb ?? `All ${section.label} entries.`}
>
  <div>
    <p class="back"><a href={withBase('/hub/')}>← All Entries</a></p>
    <h1>{section.label}</h1>
    <p class="muted">
      {nav.total} pages · grouped by {section.groupField ?? 'section'}
    </p>

    <div class="filters panel">
      <label>
        Search
        <input id="f-search" type="search" placeholder={`Cari ${section.label}…`} autocomplete="off" />
      </label>
      {
        filters.map((f) => (
          <label>
            {f.label}
            <select id={`f-${f.field}`} data-field={f.field}>
              <option value="">All</option>
              {f.options.map((opt) => (
                <option value={opt}>{opt}</option>
              ))}
            </select>
          </label>
        ))
      }
      <button id="f-reset" class="btn" type="button">✕ Reset</button>
      <p id="f-count" class="f-count muted" aria-live="polite"></p>
    </div>

    {
      nav.groups.map((group) => (
        <section data-group={group.label}>
          <h2>
            {group.label} <span class="count">{group.count}</span>
          </h2>
          <div class="card-grid">
            {group.items.map((item) => (
              <div
                class="cell"
                data-name={item.title.toLowerCase()}
                {...Object.fromEntries(
                  filters.map((f) => [`data-${f.field}`, item.values[f.field] ?? ''])
                )}
              >
                <a class="g-card panel" href={item.href}>
                  <span class="g-icon" aria-hidden="true">
                    <EntryIcon name={item.icon} emoji={item.emoji} />
                  </span>
                  <h3>{item.title}</h3>
                  {item.description && <p>{item.description}</p>}
                </a>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('f-search') as HTMLInputElement;
  const resetBtn = document.getElementById('f-reset');
  const countEl = document.getElementById('f-count');

  // Dropdown filter dibangun dinamis per koleksi — ambil semuanya generik.
  const selects = Array.from(
    document.querySelectorAll<HTMLSelectElement>('.filters select')
  );
  const cells = Array.from(document.querySelectorAll<HTMLElement>('.cell'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[data-group]'));

  function applyFilters(): void {
    const search = searchInput.value.trim().toLowerCase();
    const active = new Map<string, string>();
    for (const sel of selects) {
      const field = sel.dataset.field ?? '';
      if (sel.value) active.set(field, sel.value);
    }

    let visible = 0;

    for (const cell of cells) {
      const name = (cell.dataset.name ?? '').toLowerCase();
      let show = !search || name.includes(search);
      if (show) {
        for (const [field, value] of active) {
          if ((cell.dataset[field] ?? '') !== value) {
            show = false;
            break;
          }
        }
      }
      cell.hidden = !show;
      if (show) visible++;
    }

    for (const section of sections) {
      const anyVisible = Array.from(
        section.querySelectorAll<HTMLElement>('.cell')
      ).some((cell) => !cell.hidden);
      section.hidden = !anyVisible;
    }

    if (countEl) {
      countEl.textContent = `${visible} of ${cells.length} entries match`;
    }
  }

  searchInput.addEventListener('input', applyFilters);
  for (const sel of selects) sel.addEventListener('change', applyFilters);
  resetBtn?.addEventListener('click', () => {
    searchInput.value = '';
    for (const sel of selects) sel.value = '';
    applyFilters();
  });
  applyFilters();
</script>
