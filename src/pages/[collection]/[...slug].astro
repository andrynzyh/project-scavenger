---
/**
 * DETAIL ENTRY — satu halaman untuk SEMUA koleksi.
 * Menangani badge khusus per koleksi (rank/attribute/role untuk digimon,
 * version/date/type untuk patchnote) + injeksi komponen khusus (tamer,
 * novice-challenge) + navigasi prev/next.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryIcon from '../../components/EntryIcon.astro';
import TamerList from '../../components/TamerList.astro';
import NoviceChallenge from '../../components/NoviceChallenge.astro';
import { getCollection, render } from 'astro:content';
import { getCollectionMeta, COLLECTION_NAMES } from '../../lib/collections';
import { getSectionByCollection } from '../../lib/navigation';
import { resolveIcon } from '../../lib/icons';
import { withBase } from '../../lib/paths';

export async function getStaticPaths() {
  const perCollection = await Promise.all(
    COLLECTION_NAMES.map(async (collection) => {
      const entries = await getCollection(
        collection as Parameters<typeof getCollection>[0]
      );
      return entries.map((entry) => ({
        params: { collection, slug: entry.id },
        props: { entry },
      }));
    })
  );
  return perCollection.flat();
}

interface Props {
  /* eslint-disable-next-line @typescript-eslint/no-explicit-any */
  entry: any;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Prev / next dalam koleksi yang sama (urut "order")
const siblings = (
  await getCollection(entry.collection as Parameters<typeof getCollection>[0])
).sort(
  (a, b) =>
    ((a.data as Record<string, unknown>).order as number ?? 99) -
    ((b.data as Record<string, unknown>).order as number ?? 99)
);
const index = siblings.findIndex((e) => e.id === entry.id);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;

const data = entry.data as Record<string, any>;
const section = getSectionByCollection(entry.collection as string)!;
const meta = getCollectionMeta(entry.collection as string);
const base = withBase(`/${entry.collection}/`);
const icon = resolveIcon({
  collection: entry.collection as string,
  slug: entry.id,
  icon: data.icon,
});
const isPatchnote = entry.collection === 'patchnote';
const patchDate = isPatchnote && data.date
  ? new Date(data.date).toISOString().slice(0, 10)
  : undefined;
---

<BaseLayout title={`${data.title} — project-scavenger`} description={data.description}>
  <article>
    <nav class="crumbs" aria-label="Breadcrumb">
        <a href={withBase('/hub/')}>← All Entries</a> <span>/</span>
        <a href={base}>{section.label}</a> <span>/</span>
        <span class="here">{data.title}</span>
      </nav>

      <header class="head panel">
        <span class="emoji">
          <EntryIcon name={icon} emoji={data.emoji} />
        </span>
        <div>
          <h1>{data.title}</h1>
          <div class="meta">
            {data.category && <span class="badge blue">{data.category}</span>}
            {data.rank && <span class="badge accent">{data.rank}</span>}
            {data.attribute && <span class="badge">{data.attribute}</span>}
            {data.role && <span class="badge">{data.role}</span>}
            {data.owner && <span class="badge accent">Owner: {data.owner}</span>}
            {isPatchnote && data.version && <span class="badge blue">v{data.version}</span>}
            {isPatchnote && patchDate && <span class="badge">{patchDate}</span>}
            {isPatchnote && data.type && (
              <span class:list={['badge', { major: data.type === 'Major' }]}>{data.type}</span>
            )}
          </div>
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      {meta?.name === 'system' && entry.id === 'tamer' && <TamerList />}
      {meta?.name === 'system' && entry.id === 'novice-challenge' && <NoviceChallenge />}

      {
        data.tags?.length > 0 && (
          <p class="tags">
            {data.tags.map((tag: string) => (
              <span class="badge">#{tag}</span>
            ))}
          </p>
        )
      }

      <hr />

      <nav class="pager" aria-label="Entry navigation">
        {
          prev ? (
            <a class="btn" href={`${base}${prev.id}/`}>
              ← {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="btn" href={`${base}${next.id}/`}>
              {next.data.title} →
            </a>
          ) : (
            <span />
          )
        }
      </nav>
  </article>
</BaseLayout>

<style>
  article {
    padding: 0;
  }

  .crumbs {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--muted);
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .here { color: var(--accent); }
  .head {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .head :global(.emoji) { font-size: 4rem; line-height: 1; }
  .head h1 { margin: 0 0 0.4rem; }
  .meta { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .meta :global(.badge.major) {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
  }
  .tags { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>